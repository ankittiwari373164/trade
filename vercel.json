{
  "version": 2,
  "builds": [{ "src": "server.js", "use": "@vercel/node" }],
  "routes": [{ "src": "/(.*)", "dest": "server.js" }],
  "crons": [
    { "path": "/api/cron/load-history", "schedule": "0 3 * * *" },
    { "path": "/api/cron/snapshot-915", "schedule": "45 3 * * *" },
    { "path": "/api/cron/snapshot-925", "schedule": "55 3 * * *" },
    { "path": "/api/cron/reset",        "schedule": "30 10 * * *" }
  ]
}